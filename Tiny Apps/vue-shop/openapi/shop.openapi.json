{
  "openapi": "3.1.0",
  "info": {
    "title": "Vue Shop API",
    "version": "1.0.0"
  },
  "tags": [
    {
      "name": "products",
      "description": "Product catalog"
    }
  ],
  "paths": {
    "/api/products": {
      "get": {
        "tags": ["products"],
        "operationId": "getProducts",
        "summary": "Retrieve the list of products",
        "responses": {
          "200": {
            "description": "List of products",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Product"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Product": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "price",
          "imageUrl"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
           "description": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "minimum": 0
          },
          "imageUrl": {
            "type": "string"
          }
        }
      }
    }
  }
}
